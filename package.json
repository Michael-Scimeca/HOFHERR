{
  "name": "hofherr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 2000",
    "build": "next build",
    "start": "next start -p 2000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "npx react-doctor@latest --scope changed",
    "doctor:staged": "npx react-doctor@latest --staged --blocking warning",
    "doctor:design": "npx react-doctor@latest design --verbose",
    "check-hover-transitions": "node scripts/check-hover-transitions.mjs",
    "check-headings": "node scripts/check-heading-classes.mjs",
    "check-all": "npm run typecheck && npm run check-hover-transitions && npm run check-headings && npm run doctor && npm run test",
    "lhci": "lhci autorun",
    "test:safari": "playwright test tests/mobile-safari.spec.ts",
    "test:iphone": "playwright test tests/mobile-safari.spec.ts tests/mobile-screens.spec.ts --project=\"iPhone 15\" --project=\"iPhone SE\" --retries=1",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "compress:images": "ts-node scripts/compress-images.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sanity/color-input": "^6.0.4",
    "@sanity/table": "^2.0.1",
    "@sanity/vision": "^5.14.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "dictionary-en": "^4.0.0",
    "gsap": "^3.14.2",
    "html-to-image": "^1.11.11",
    "lenis": "^1.3.19",
    "lottie-web": "^5.13.0",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.30",
    "next-sanity": "^12.1.1",
    "nodemailer": "^7.0.7",
    "nspell": "^2.1.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanity": "^5.14.1",
    "sanity-plugin-asset-source-unsplash": "^7.0.5",
    "sanity-plugin-media": "^4.1.1",
    "sanity-plugin-note-field": "^3.1.0",
    "sharp": "^0.34.5",
    "stripe": "^20.4.1",
    "styled-components": "^6.3.11",
    "three": "^0.183.2",
    "twilio": "^5.12.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@sanity/client": "^7.17.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/youtube": "^0.1.2",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "proxy-agent": "^8.0.2",
    "react-doctor": "^0.9.22",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "browserslist": [
    "chrome 111",
